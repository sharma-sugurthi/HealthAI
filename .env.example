# =============================================================================
# HealthAI Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# -----------------------------------------------------------------------------
# Required: OpenRouter API Key
# -----------------------------------------------------------------------------
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# For development (SQLite):
DATABASE_URL=sqlite:///healthai.db
DB_AUTO_CREATE_SCHEMA=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# For production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/healthai
# DB_AUTO_CREATE_SCHEMA=false
# Example with Docker:
# DATABASE_URL=postgresql+psycopg2://healthai:healthai_password@localhost:5432/healthai

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Generate a secure secret key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_change_in_production

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# AI Model Configuration (Optional - uses defaults if not set)
# -----------------------------------------------------------------------------
AI_MODEL=qwen/qwen3.6-plus-preview:free
AI_MAX_RETRIES=3
AI_RETRY_DELAY=2
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://healthai.app
OPENROUTER_TITLE=HealthAI Assistant

# -----------------------------------------------------------------------------
# Application Configuration (Optional)
# -----------------------------------------------------------------------------
APP_NAME=HealthAI
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE=logs/healthai.log

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
